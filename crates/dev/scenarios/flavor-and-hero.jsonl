# Durotar and the sheet of the hero.

{"type": "character_described", "at": 30, "race": "Troll", "class": "SHAMAN"}
{"type": "zone_entered", "at": 60, "zone": "Durotar", "subzone": "Valley of Trials", "hour": 14}
{"type": "hero_set", "at": 90, "field": "origin", "text": "Born on the Echo Isles, under the eye of Vol'jin."}
{"type": "hero_set", "at": 120, "field": "background", "text": "I fished the reef until the sea witch came. Now I follow the spirits."}
{"type": "hero_set", "at": 150, "field": "goal", "text": "Find the spirit that spoke to me on the reef."}
{"type": "hero_set", "at": 180, "field": "bond", "text": "My brother Zan'tu, who stayed on the isles."}
{"type": "hero_set", "at": 210, "field": "flaw", "text": "I laugh at the wrong time, even at funerals."}
{"type": "hero_set", "at": 240, "field": "traits", "text": "Patient with beasts, short with orcs who boast."}

{"type": "hero_set", "at": 270, "field": "title", "text": "Speaker of the Reef"}
{"type": "hero_set", "at": 300, "field": "currently", "text": "Looking for a good fishing spot."}
{"type": "hero_set", "at": 330, "field": "appearance", "text": "Blue skin painted with white tide marks, tusks bound in copper."}
{"type": "hero_set", "at": 360, "field": "age", "text": "Young for a troll"}
{"type": "hero_set", "at": 390, "field": "motto", "text": "The tide always comes back."}

{"type": "npc_met", "at": 420, "name": "Master Gadrin"}
{"type": "hero_added", "at": 450, "text": "Master Gadrin knew my mother's name.", "npc": "Master Gadrin"}
{"type": "hero_added", "at": 480, "text": "The spirits went quiet when I left the isles."}
{"type": "hero_added", "at": 510, "text": "A note that I took back."}
