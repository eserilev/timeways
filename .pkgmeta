# The BigWigs packager reads this file to build the CurseForge zip.
# The addon lives in addon/Timeways, so the packager moves that folder to the top of the zip.
# Everything else in the repository stays out. The release job checks the zip against the TOC.
package-as: Timeways

# The packager writes the git history as the changelog by default, with every commit trailer.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

move-folders:
  Timeways/addon/Timeways: Timeways

ignore:
  - .cargo
  - .github
  - .gitignore
  - .pkgmeta
  - .styluaignore
  - Cargo.lock
  - Cargo.toml
  - CLAUDE.md
  - clippy.toml
  - crates
  - deny.toml
  - docs
  - fuzz
  - GAMEPLAY.md
  - README.md
  - rustfmt.toml
  - scripts
  - selene.toml
  - TESTING.md
  - wow.yml
  - addon/tests
  # An old desktop app wrote the key of the computer here. The key now lives in the
  # Timeways_Key addon. A key never goes into a package.
  - addon/Timeways/Key.lua
