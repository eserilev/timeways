# The BigWigs packager reads this file to build the CurseForge zip.
# The addon lives in addon/Timeways, so the packager moves that folder to the top of the zip.
# Everything else in the repository stays out. The release job checks the zip against the TOC.
package-as: Timeways

move-folders:
  Timeways/addon/Timeways: Timeways

ignore:
  - .cargo
  - .github
  - .gitignore
  - .pkgmeta
  - .styluaignore
  - Cargo.lock
  - Cargo.toml
  - CLAUDE.md
  - clippy.toml
  - crates
  - deny.toml
  - fuzz
  - GAMEPLAY.md
  - README.md
  - rustfmt.toml
  - scripts
  - selene.toml
  - TESTING.md
  - wow.yml
  - addon/tests
  # The bridge writes the key on each computer. It never goes into a package.
  - addon/Timeways/Key.lua
